// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  RESEARCHER
  STAFF
  EXECUTIVE
}

enum ProjectStatus {
  PROPOSED
  APPROVED
  ONGOING
  COMPLETED
  TERMINATED
}

enum Quartile {
  Q1
  Q2
  Q3
  Q4
}

enum RewardStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PublicationStatus {
  WRITING
  UNDER_REVIEW
  PUBLISHED
  REWARDED
}

enum PresentationStatus {
  PENDING
  PRESENTED
}

enum PresentationType {
  ORAL
  POSTER
}

enum ConsultType {
  PROTOCOL
  STATISTICAL
}

enum ConsultStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model User {
  id                    String            @id @default(uuid())
  name                  String
  email                 String            @unique
  role                  UserRole
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  
  // Relations
  ledProjects           ResearchProject[] @relation("ProjectLeader")
  authoredPublications  Publication[]     @relation("PublicationAuthor")
  givenConsultations    Consultation[]    @relation("ConsultAdvisor")
  receivedConsultations Consultation[]    @relation("ConsultRequester")
  presentations         Presentation[]    @relation("Presenter")
}

model ResearchProject {
  id             String        @id @default(uuid())
  title          String
  status         ProjectStatus
  budgetInitial  Float
  budgetSpent    Float         @default(0)
  startDate      DateTime
  endDate        DateTime
  
  // Extra fields
  ceuConsultDate DateTime?
  irbNo          String?
  approvedDate   DateTime?
  department     String?

  // Relations
  leaderId       String
  leader         User          @relation("ProjectLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  publications   Publication[]
  presentations  Presentation[]
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Publication {
  id           String            @id @default(uuid())
  title        String
  journal      String
  quartile     Quartile
  rewardStatus RewardStatus      @default(PENDING)
  rewardAmount Float             @default(0)
  status       PublicationStatus @default(WRITING)
  
  // Relations
  projectId    String?
  project      ResearchProject?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  authorId     String
  author       User              @relation("PublicationAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Presentation {
  id           String             @id @default(uuid())
  title        String
  conference   String
  type         PresentationType
  status       PresentationStatus @default(PENDING)

  // Relations
  projectId    String?
  project      ResearchProject?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  presenterId  String
  presenter    User               @relation("Presenter", fields: [presenterId], references: [id], onDelete: Cascade)

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model Consultation {
  id              String        @id @default(uuid())
  type            ConsultType
  appointmentTime DateTime
  status          ConsultStatus @default(SCHEDULED)

  // Relations
  advisorId       String
  advisor         User          @relation("ConsultAdvisor", fields: [advisorId], references: [id], onDelete: Cascade)
  requesterId     String
  requester       User          @relation("ConsultRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
